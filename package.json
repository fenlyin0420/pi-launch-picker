{
  "name": "@fenlyin/pi-launch-picker",
  "version": "0.1.0",
  "description": "Pi extension: pick active tools, a system prompt preset and saved profiles before the conversation starts — from the TUI, a CLI flag, or RPC.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "launch",
    "profile",
    "system-prompt",
    "tools"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "author": "fenlyin0420",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenlyin0420/pi-launch-picker.git"
  },
  "homepage": "https://github.com/fenlyin0420/pi-launch-picker#readme",
  "bugs": {
    "url": "https://github.com/fenlyin0420/pi-launch-picker/issues"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ]
}
